{
  "name": "novastone",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate-products": "node scripts/generateProducts.js",
    "copy-images": "node scripts/copyProductImages.js",
    "setup-products": "npm run copy-images && npm run generate-products",
    "tecno-local": "concurrently --kill-others-on-fail \"npm run supabase:start\" \"npm run dev\" \"npm run admin:dev\"",
    "supabase:start": "cd ../tecnofit-supabase && npx supabase start && npx supabase status",
    "supabase:stop": "cd ../tecnofit-supabase && npx supabase stop",
    "supabase:status": "cd ../tecnofit-supabase && npx supabase status",
    "admin:dev": "cd ../admin && npm run dev"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.87.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/analytics": "^1.5.0",
    "gsap": "^3.13.0",
    "mammoth": "^1.11.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-compiler": "^19.1.0-rc.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.14",
    "vite": "^7.1.7"
  }
}
